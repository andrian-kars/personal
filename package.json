{
  "homepage": "https://andrian-kars.com",
  "name": "personal",
  "version": "1.0.0",
  "private": true,
  "description": "andrian-kars's personal website",
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "lint": "eslint --ext .jsx --ext .js src/"
  },
  "lint": "eslint .",
  "lint:fix": "eslint --fix",
  "format": "prettier --write './**/*.{js,jsx,scss,css,md,json}' --config ./.prettierrc",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/andrian-kars/personal.git"
  },
  "keywords": [
    "personal",
    "website"
  ],
  "author": "andrian-kars",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andrian-kars/personal/issues"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^3.0.0",
    "classnames": "^2.3.1",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.30.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "sass": "^1.57.1",
    "vite": "^4.0.3"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^6.1.0",
    "react-router-dom": "^6.3.0",
    "remove": "^0.1.5"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "yarn lint"
    ],
    "**/*.{js,jsx,json,css,scss,md}": [
      "yarn prettier --write"
    ]
  }
}
